// ─────────────────────────────────────────
// COLECCIÓN: lotes
// Equivale a: lote
// Decisión: REFERENCE a producto y bodega
//           (uno-a-muchos; muchos lotes por producto)
// ─────────────────────────────────────────
db.createCollection("lotes", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["id_producto", "numero_lote", "fecha_produccion",
                 "fecha_vencimiento", "cantidad_bultos_inicial",
                 "id_bodega", "id_usuario_productor", "estado_activo"],
      properties: {
        id_producto:            { bsonType: "objectId" },
        id_bodega:              { bsonType: "objectId" },
        id_usuario_productor:   { bsonType: "objectId" },
        numero_lote:            { bsonType: "string" },
        fecha_produccion:       { bsonType: "date" },
        fecha_vencimiento:      { bsonType: "date" },
        cantidad_bultos_inicial:{ bsonType: "int", minimum: 1 },
        estado_activo:          { bsonType: "bool" },
        observaciones:          { bsonType: ["string", "null"] },
        fecha_registro:         { bsonType: "date" },
        fecha_desactivacion:    { bsonType: ["date", "null"] }
      }
    }
  }
});

db.lotes.createIndex({ id_producto: 1, numero_lote: 1 }, { unique: true });
db.lotes.createIndex({ id_bodega: 1 });
db.lotes.createIndex({ fecha_vencimiento: 1 });
db.lotes.createIndex({ estado_activo: 1 });


// ─────────────────────────────────────────
// COLECCIÓN: stock
// Equivale a: stock_bodega + stock_tienda (UNIFICADA)
// Decisión: una sola colección con campo discriminador "tipo_ubicacion"
//           Elimina la duplicación de esquema idéntico en dos tablas SQL
// ─────────────────────────────────────────
db.createCollection("stock", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["tipo_ubicacion", "id_ubicacion", "id_producto",
                 "id_lote", "cantidad_actual"],
      properties: {
        tipo_ubicacion:        { bsonType: "string", enum: ["BODEGA", "TIENDA"] },
        id_ubicacion:          { bsonType: "objectId" },
        id_producto:           { bsonType: "objectId" },
        id_lote:               { bsonType: "objectId" },
        cantidad_actual:       { bsonType: "int", minimum: 0 },
        stock_minimo_seguridad:{ bsonType: "int", minimum: 0 },
        fecha_ultima_auditoria:{ bsonType: "date" }
      }
    }
  }
});

db.stock.createIndex(
  { tipo_ubicacion: 1, id_ubicacion: 1, id_producto: 1, id_lote: 1 },
  { unique: true }
);
db.stock.createIndex({ id_producto: 1 });
db.stock.createIndex({ id_lote: 1 });
db.stock.createIndex({ cantidad_actual: 1, stock_minimo_seguridad: 1 });


// ─────────────────────────────────────────
// COLECCIÓN: movimientos
// Equivale a: movimiento_inventario + entrada + salida (UNIFICADA)
// Decisión: EMBED subtipo (entrada/salida son solo discriminadores)
//           entrada.tipo_ingreso y salida.tipo_salida → campo "subtipo"
// ─────────────────────────────────────────
db.createCollection("movimientos", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["id_producto", "id_lote", "id_usuario",
                 "tipo_movimiento", "cantidad", "fecha_movimiento"],
      properties: {
        id_producto:     { bsonType: "objectId" },
        id_lote:         { bsonType: "objectId" },
        id_usuario:      { bsonType: "objectId" },
        tipo_movimiento: {
          bsonType: "string",
          enum: ["ENTRADA", "SALIDA", "VENTA", "DEVOLUCION", "ABASTECIMIENTO"]
        },
        subtipo: {
          bsonType: ["string", "null"],
          // ENTRADA: PRODUCCION | TRANSFERENCIA | AJUSTE_EXTRA
          // SALIDA:  TRANSFERENCIA | FALTANTE | PERDIDA | DAÑO
          enum: ["PRODUCCION", "TRANSFERENCIA", "AJUSTE_EXTRA",
                 "FALTANTE", "PERDIDA", "DAÑO", null]
        },
        cantidad:        { bsonType: "int", minimum: 1 },
        fecha_movimiento:{ bsonType: "date" },
        ubicacion: {
          bsonType: "object",
          required: ["tipo", "id_ubicacion"],
          properties: {
            tipo:        { bsonType: "string", enum: ["BODEGA", "TIENDA"] },
            id_ubicacion:{ bsonType: "objectId" }
          }
        },
        observaciones: { bsonType: ["string", "null"] }
      }
    }
  }
});

db.movimientos.createIndex({ id_producto: 1 });
db.movimientos.createIndex({ id_lote: 1 });
db.movimientos.createIndex({ fecha_movimiento: -1 });
db.movimientos.createIndex({ tipo_movimiento: 1 });
db.movimientos.createIndex({ "ubicacion.id_ubicacion": 1, tipo_movimiento: 1 });


// ─────────────────────────────────────────
// COLECCIÓN: ventas
// Equivale a: venta + venta_detalle + devolucion_detalle (UNIFICADA)
// Decisión:
//   - venta_detalle → EMBED como array "items" (uno-a-pocos, lectura conjunta)
//   - devolucion_detalle → EMBED como objeto "anulacion" (solo existe si anulada)
// ─────────────────────────────────────────
db.createCollection("ventas", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["id_cliente", "id_usuario", "id_tienda",
                 "fecha_venta", "estado", "items"],
      properties: {
        id_cliente:  { bsonType: "objectId" },
        id_usuario:  { bsonType: "objectId" },
        id_tienda:   { bsonType: "objectId" },
        fecha_venta: { bsonType: "date" },
        estado:      { bsonType: "string", enum: ["ACTIVA", "ANULADA"] },

        // Detalle embebido (equivale a venta_detalle)
        items: {
          bsonType: "array",
          minItems: 1,
          items: {
            bsonType: "object",
            required: ["id_producto", "id_lote", "cantidad", "id_movimiento"],
            properties: {
              id_producto:  { bsonType: "objectId" },
              id_lote:      { bsonType: "objectId" },
              cantidad:     { bsonType: "int", minimum: 1 },
              id_movimiento:{ bsonType: "objectId" }
            }
          }
        },

        // Solo existe si estado = ANULADA (equivale a devolucion_detalle)
        anulacion: {
          bsonType: "object",
          properties: {
            id_usuario_anulo: { bsonType: "objectId" },
            motivo:           { bsonType: "string" },
            fecha_anulacion:  { bsonType: "date" },
            movimientos_devolucion: {
              bsonType: "array",
              items: {
                bsonType: "object",
                properties: {
                  id_producto:      { bsonType: "objectId" },
                  id_lote:          { bsonType: "objectId" },
                  cantidad_devuelta:{ bsonType: "int", minimum: 1 },
                  id_movimiento:    { bsonType: "objectId" }
                }
              }
            }
          }
        }
      }
    }
  }
});

db.ventas.createIndex({ id_cliente: 1 });
db.ventas.createIndex({ id_tienda: 1, fecha_venta: -1 });
db.ventas.createIndex({ estado: 1 });
db.ventas.createIndex({ "items.id_producto": 1 });
db.ventas.createIndex({ "items.id_lote": 1 });


// ─────────────────────────────────────────
// COLECCIÓN: alertas
// Equivale a: alerta
// Mejora respecto al SQL: se agrega campo "leida" y "resuelta"
//   (corrige el problema identificado en la Fase 1)
// ─────────────────────────────────────────
db.createCollection("alertas", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["tipo", "mensaje", "fecha_creacion", "leida", "resuelta"],
      properties: {
        tipo: {
          bsonType: "string",
          enum: ["STOCK_BAJO", "LOTE_PROXIMO_VENCER", "BODEGA_LLENA"]
        },
        id_producto:   { bsonType: ["objectId", "null"] },
        id_lote:       { bsonType: ["objectId", "null"] },
        id_ubicacion:  { bsonType: ["objectId", "null"] },
        tipo_ubicacion:{ bsonType: ["string", "null"],
                         enum: ["BODEGA", "TIENDA", null] },
        mensaje:       { bsonType: "string" },
        fecha_creacion:{ bsonType: "date" },
        leida:         { bsonType: "bool" },
        resuelta:      { bsonType: "bool" }
      }
    }
  }
});

db.alertas.createIndex({ leida: 1, resuelta: 1, fecha_creacion: -1 });
db.alertas.createIndex({ tipo: 1 });
db.alertas.createIndex({ id_lote: 1 });

