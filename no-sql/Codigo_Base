});

db.categorias.createIndex({ codigo_categoria: 1 }, { unique: true });
db.categorias.createIndex({ nombre_categoria: 1 }, { unique: true });


// ─────────────────────────────────────────
// COLECCIÓN: productos
// Equivale a: producto
// Decisión: DENORMALIZA nombre y código de categoria
//           (se lee siempre junto; categoria cambia rarísimo)
// ─────────────────────────────────────────
db.createCollection("productos", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["codigo_tipo_sal", "id_categoria", "nombre_sal_mineralizada",
                 "presentacion", "peso_bulto_kg", "porcentaje_fosforo",
                 "unidad_medida", "estado_activo"],
      properties: {
        codigo_tipo_sal:         { bsonType: "string" },
        id_categoria:            { bsonType: "objectId" },

        // Datos denormalizados de categoria (evitar JOIN en lecturas frecuentes)
        categoria: {
          bsonType: "object",
          required: ["codigo", "nombre"],
          properties: {
            codigo:  { bsonType: "string" },
            nombre:  { bsonType: "string" }
          }
        },

        nombre_sal_mineralizada: { bsonType: "string" },
        presentacion:            { bsonType: "string" },
        peso_bulto_kg:           { bsonType: "int", minimum: 0, exclusiveMinimum: true},
        porcentaje_fosforo:      { bsonType: "int", minimum: 0, maximum: 100 },
        unidad_medida:           { bsonType: "string" },
        descontinuado:           { bsonType: "bool" },
        estado_activo:           { bsonType: "bool" },
        fecha_creacion:          { bsonType: "date" },
        fecha_desactivacion:     { bsonType: ["date", "null"] }
      }
    }
  }
});

db.productos.createIndex({ codigo_tipo_sal: 1 }, { unique: true });
db.productos.createIndex({ id_categoria: 1 });
db.productos.createIndex({ estado_activo: 1 });


// ─────────────────────────────────────────
// COLECCIÓN: bodegas
// Equivale a: bodega
