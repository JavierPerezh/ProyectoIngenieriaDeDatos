        estado_activo:     { bsonType: "bool" }
      }
    }
  }
});

db.clientes.createIndex({ nit_cedula: 1 }, { unique: true });


// ─────────────────────────────────────────
// COLECCIÓN: categorias
// Equivale a: categoria
// ─────────────────────────────────────────
db.createCollection("categorias", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["codigo_categoria", "nombre_categoria", "estado_activo"],
      properties: {
        codigo_categoria:    { bsonType: "string" },
        nombre_categoria:    { bsonType: "string" },
