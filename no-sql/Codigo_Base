// ─────────────────────────────────────────
// COLECCIÓN: usuarios
// Equivale a: usuario
// ─────────────────────────────────────────
db.createCollection("usuarios", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["nombre_completo", "username", "email", "password_hash",
                 "password_salt", "numero_documento", "rol", "estado_activo"],
      properties: {
        nombre_completo:     { bsonType: "string" },
        username:            { bsonType: "string" },
        email:               { bsonType: "string" },
        password_hash:       { bsonType: "string" },
        password_salt:       { bsonType: "string" },
        numero_documento:    { bsonType: "string" },
        rol:                 { bsonType: "string", enum: ["ADMIN", "VENDEDOR"] },
        estado_activo:       { bsonType: "bool" },
        fecha_creacion:      { bsonType: "date" },
        fecha_desactivacion: { bsonType: ["date", "null"] },
        ultimo_acceso:       { bsonType: ["date", "null"] }
      }
    }
  }
});

db.usuarios.createIndex({ username: 1 },         { unique: true });
db.usuarios.createIndex({ email: 1 },            { unique: true });
db.usuarios.createIndex({ numero_documento: 1 }, { unique: true });


// ─────────────────────────────────────────
// COLECCIÓN: sesiones
// Equivale a: sesion_usuario
// Decisión: REFERENCE (uno-a-muchísimos)
// ─────────────────────────────────────────
db.createCollection("sesiones", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["id_usuario", "token_sesion", "fecha_inicio", "estado_sesion"],
      properties: {
        id_usuario:    { bsonType: "objectId" },
        token_sesion:  { bsonType: "string" },
        fecha_inicio:  { bsonType: "date" },
        fecha_cierre:  { bsonType: ["date", "null"] },
        estado_sesion: { bsonType: "string", enum: ["ABIERTA", "CERRADA"] }
      }
    }
  }
});

db.sesiones.createIndex({ token_sesion: 1 }, { unique: true });
db.sesiones.createIndex({ id_usuario: 1 });
db.sesiones.createIndex({ estado_sesion: 1, id_usuario: 1 });


// ─────────────────────────────────────────
// COLECCIÓN: clientes
// Equivale a: cliente
// ─────────────────────────────────────────
db.createCollection("clientes", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["nit_cedula", "nombre_cliente", "tipo", "estado_activo"],
      properties: {
        nit_cedula:        { bsonType: "string" },
        nombre_cliente:    { bsonType: "string" },
        telefono:          { bsonType: ["string", "null"] },
        email:             { bsonType: ["string", "null"] },
        direccion_entrega: { bsonType: ["string", "null"] },
