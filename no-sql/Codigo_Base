print("\n══ Verificación RQF060 — Registros con stock bajo el mínimo ══");
const stockBajo = db.stock.find({
  tipo_ubicacion: "BODEGA",
  $expr: { $lt: ["$cantidad_actual", "$stock_minimo_seguridad"] }
}).toArray();

if (stockBajo.length === 0) {
  print("  ✘ Ningún registro bajo el mínimo — revisar datos.");
} else {
  stockBajo.forEach(function(s) {
    const prod   = db.productos.findOne({ _id: s.id_producto });
    const bodega = db.bodegas.findOne({ _id: s.id_ubicacion });
    print("  ✔ [BAJO] Bodega: " + (bodega ? bodega.nombre_bodega : s.id_ubicacion) +
          " | Producto: " + (prod ? prod.codigo_tipo_sal : s.id_producto) +
          " | actual: " + s.cantidad_actual +
          " | mínimo: " + s.stock_minimo_seguridad);
  });
}

print("\n══ Verificación RQF061 — Bodegas llenas o sobre capacidad ══");
db.stock.aggregate([
  { $match: { tipo_ubicacion: "BODEGA" } },
  { $group: {
      _id:          "$id_ubicacion",
      total_bultos: { $sum: "$cantidad_actual" }
  }}
]).forEach(function(r) {
  const bodega = db.bodegas.findOne({ _id: r._id });
  if (!bodega) return;
  const estado = r.total_bultos >= bodega.capacidad_maxima_bultos ? "✔ [LLENA]" : "  (normal)";
  print("  " + estado + " " + bodega.nombre_bodega +
        ": " + r.total_bultos + " / " + bodega.capacidad_maxima_bultos + " bultos");
});

