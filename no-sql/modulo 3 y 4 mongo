print("\n>>> [2/4] EJECUTANDO SET DE 14 CONSULTAS ESPECÍFICAS AVANZADAS <<<");

print("\n--- 2.1) CONSULTAS ESPECÍFICAS PARA LA INFRAESTRUCTURA DE BODEGAS (MÓDULO 4) ---");

// Consulta 1: Filtrar bodegas que se encuentren operativas y disponibles en el sistema
