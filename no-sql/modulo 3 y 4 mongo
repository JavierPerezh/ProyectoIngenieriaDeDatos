// Consulta 6: Listar bodegas temporalmente fuera de servicio o suspendidas por auditoría
print("C6: Bodegas en estado INACTIVA:");
db.bodegas.find({ "estado": "INACTIVA" });

// Consulta 7: Consultar bodegas con un rango de almacenamiento intermedio (Entre 1000 y 2500 bultos inclusive)
print("C7: Bodegas con capacidad intermedia (Entre 1000 y 2500 bultos):");
