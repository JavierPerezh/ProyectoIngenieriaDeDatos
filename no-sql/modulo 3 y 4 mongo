  "tipo_movimiento": "ENTRADA_PRODUCCION", 
  "fecha": { $gte: ISODate("2026-04-01T00:00:00Z") } 
});


// =============================================================================
// 3. REQUERIMIENTO: OPERACIONES DE MODIFICACIÓN Y ELIMINACIÓN (5 UPDATES / 1 DELETE)
// =============================================================================
print("\n>>> [3/4] EJECUTANDO OPERACIONES DE MUTACIÓN DE DATOS (DML) <<<");

// Modificación 1: Actualizar la ubicación y expandir la capacidad física de la Bodega Principal por reformas
print("M1: Ampliación de infraestructura física para Bodega 1...");
db.bodegas.updateOne(
  { "_id": new ObjectId("bbbbbb000000000000000001") },
  { $set: { "direccion": "Zona Industrial Lote 14 Km 2 - Sogamoso Ampliada", "capacidad_bultos": 3500 } }
);

// Modificación 2: Desactivar masivamente de forma preventiva bodegas críticas con capacidad inferior a 600 bultos
print("M2: Clausura preventiva masiva de bodegas pequeñas (< 600 bultos)...");
db.bodegas.updateMany(
  { "capacidad_bultos": { $lt: 600 } },
  { $set: { "estado": "INACTIVA" } }
);

// Modificación 3: Recalibrar el saldo real de bultos del lote LOT-001 tras un proceso de auditoría y conteo físico en planta
print("M3: Ajuste de inventario atómico para el lote LOT-001...");
db.lotes.updateOne(
  { "codigo_lote": "LOT-001" },
  { $set: { "cantidad": 520 } }
);

// Modificación 4: Enmendar y complementar la descripción aclaratoria de un movimiento de entrada específico (Movimiento 1)
print("M4: Actualización de glosa de auditoría en el movimiento 1...");
db.movimientos.updateOne(
  { "_id": new ObjectId("mmmmmm000000000000000001") },
  { $set: { "observaciones": "Entrada de lote aprobada plenamente por control de calidad y el jefe de planta." } }
);

// Modificación 5: Incorporar masivamente una bandera lógica para control de mantenimiento en movimientos de producción
print("M5: Inserción de campo dinámico de control en movimientos de entrada...");
db.movimientos.updateMany(
  { "tipo_movimiento": "ENTRADA_PRODUCCION" },
  { $set: { "requiere_auditoria_fiscal": false } }
);

// Eliminación: Remover del archivo histórico un registro de movimiento duplicado o cargado por error (Movimiento 3 del Seed)
print("D1: Eliminando registro erróneo del historial (Movimiento 3)...");
db.movimientos.deleteOne({ "_id": new ObjectId("mmmmmm000000000000000003") });


// =============================================================================
// 4. REQUERIMIENTO: CONSULTAS CRUZADAS (PIPELINES DE AGREGACIÓN MULTI-COLECCIÓN)
// =============================================================================
print("\n>>> [4/4] EJECUTANDO PIPELINES ANALÍTICOS DE CONSULTAS CRUZADAS ($LOOKUP) <<<");

print("\n--- Agregación Avanzada 1: Reporte Integrado de Trazabilidad de Lotes y Productos ---");
// Objetivo: Cruza la colección intermedia de lotes con el maestro de productos para romper el aislamiento NoSQL.
db.lotes.aggregate([
  {
    $lookup: {
      from: "productos",
      localField: "id_producto",
      foreignField: "_id",
      as: "informacion_producto"
    }
  },
  {
    $unwind: "$informacion_producto"
  },
  {
    $project: {
      "_id": 0,
      "Codigo_Lote": "$codigo_lote",
      "Saldo_Bultos_Disponibles": "$cantidad",
      "Fecha_Vencimiento_Lote": "$fecha_vencimiento",
      "Nombre_Comercial_Sal": "$informacion_producto.nombre",
      "Concentracion_Fosforo": "$informacion_producto.porcentaje_fosforo",
      "Valor_Base_Mercado": "$informacion_producto.precio_base"
    }
  }
]).pretty();


print("\n--- Agregación Avanzada 2: Historial Consolidador de Entradas con Ubicación de Bodega Custodia ---");
// Objetivo: Filtra los movimientos de entrada a almacén y les asocia la información geográfica e infraestructura de la bodega de destino.
db.movimientos.aggregate([
  {
    $match: { "tipo_movimiento": "ENTRADA_PRODUCCION" }
  },
  {
    $lookup: {
      from: "bodegas",
      localField: "id_ubicacion",
      foreignField: "_id",
      as: "bodega_destino"
    }
  },
  {
    $unwind: "$bodega_destino"
  },
  {
    $project: {
      "_id": 0,
      "Fecha_Operacion": "$fecha",
      "Bultos_Ingresados": "$cantidad",
      "Nombre_Bodega_Custodia": "$bodega_destino.nombre_bodega",
      "Ubicacion_Sede": "$bodega_destino.direccion",
      "Estado_Operativo_Bodega": "$bodega_destino.estado",
      "Anotacion_Logistica": "$observaciones"
    }
  }
]).pretty();
