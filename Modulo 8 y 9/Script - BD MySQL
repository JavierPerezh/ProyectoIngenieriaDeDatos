-- ============================================================

CREATE OR REPLACE VIEW vw_trazabilidad_lote AS

SELECT

    e.numero_lote,

    p.nombre_sal_mineralizada,

    e.fecha_entrada,

    b.nombre_bodega,

    mi.tipo_movimiento,

    mi.fecha_movimiento,

    mi.cantidad_bultos,

    c.nombre_cliente,

    u.nombre_completo AS registrado_por

FROM entrada e

JOIN stock s
    ON s.id_stock = e.id_stock

JOIN producto p
    ON p.id_producto = s.id_producto

JOIN bodega b
    ON b.id_bodega = s.id_bodega

JOIN movimiento_inventario mi
    ON mi.id_movimiento = e.id_movimiento

JOIN usuario u
    ON u.id_usuario = mi.id_usuario

LEFT JOIN salida sa
    ON sa.id_stock = s.id_stock

LEFT JOIN cliente c
    ON c.id_cliente = sa.id_cliente;

