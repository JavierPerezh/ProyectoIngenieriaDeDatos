-- ============================================================
-- RQF060 - Alerta de stock bajo
-- ============================================================

DELIMITER //

CREATE TRIGGER trg_alerta_stock_bajo

AFTER UPDATE ON stock

FOR EACH ROW

BEGIN

    DECLARE mensaje_error VARCHAR(255);

    IF NEW.cantidad_actual <= NEW.stock_minimo_seguridad THEN

        SET mensaje_error = CONCAT(
            'ALERTA: Stock bajo del producto ID ',
            NEW.id_producto,
            ' en bodega ID ',
            NEW.id_bodega
        );

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = mensaje_error;

    END IF;

END //

DELIMITER ; 

-- ============================================================
-- RQF061 - Alerta de bodega llena
-- ============================================================

DELIMITER //

CREATE TRIGGER trg_alerta_bodega_llena

AFTER UPDATE ON stock

FOR EACH ROW

BEGIN

    DECLARE total_bultos INT;

    DECLARE capacidad_maxima INT;

    DECLARE mensaje_error VARCHAR(255);

    SELECT
        SUM(cantidad_actual)
    INTO total_bultos
    FROM stock
    WHERE id_bodega = NEW.id_bodega;

    SELECT
        capacidad_maxima_bultos
    INTO capacidad_maxima
    FROM bodega
    WHERE id_bodega = NEW.id_bodega;

    IF total_bultos > capacidad_maxima THEN

        SET mensaje_error = CONCAT(
            'ALERTA: La bodega ',
            NEW.id_bodega,
            ' superó su capacidad máxima'
        );

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = mensaje_error;

    END IF;

END //

DELIMITER ;

-- ============================================================
-- RQF062 - Buscar por tipo de sal
-- Permite ver movimientos y ventas de un tipo de sal.
-- ============================================================

CREATE OR REPLACE VIEW vw_movimientos_por_tipo_sal AS

SELECT

    p.id_producto,

    p.nombre_sal_mineralizada,

    mi.id_movimiento,

    mi.tipo_movimiento,

    mi.fecha_movimiento,

    mi.cantidad_bultos,

    b.nombre_bodega,

    u.nombre_completo AS registrado_por

FROM movimiento_inventario mi

JOIN producto p
    ON p.id_producto = mi.id_producto

JOIN bodega b
    ON b.id_bodega = mi.id_bodega

JOIN usuario u
    ON u.id_usuario = mi.id_usuario;

