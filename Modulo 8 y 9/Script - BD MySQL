-- ============================================================
-- RQF069 - Ver stock de una fecha pasada
-- Calcula stock histórico.
-- ============================================================

DELIMITER //

CREATE FUNCTION fn_stock_historico(

    p_id_producto INT,
    p_fecha DATE

)

RETURNS INT

DETERMINISTIC

BEGIN

    DECLARE stock_total INT;

    SELECT
        COALESCE(SUM(
            CASE
                WHEN tipo_movimiento = 'ENTRADA'
                    THEN cantidad_bultos

                WHEN tipo_movimiento = 'DEVOLUCION'
                    THEN cantidad_bultos

                WHEN tipo_movimiento = 'SALIDA'
                    THEN -cantidad_bultos

                ELSE 0
            END
        ),0)

    INTO stock_total

    FROM movimiento_inventario

    WHERE id_producto = p_id_producto
    AND fecha_movimiento <= p_fecha;

    RETURN stock_total;

END //

DELIMITER ;

-- ============================================================
-- PROBAR RQF069
-- ============================================================

SELECT
    fn_stock_historico(1, '2026-03-01') AS stock_historico;



