// =============================================================================

print("--- EJECUTANDO CONSULTAS ESPECÍFICAS DE BODEGAS ---");
// 1. Bodegas con un estado activo verificado
db.bodegas.find({ "estado_activo": true });

// 2. Bodegas industriales con gran capacidad de almacenamiento (>= 1500 bultos)
db.bodegas.find({ "capacidad_maxima_bultos": { $gte: 1500 } });

// 3. Buscar bodegas cuya dirección contenga la palabra clave 'Calle'
db.bodegas.find({ "direccion_fisica": /Calle/i });

// 4. Bodegas pequeñas con capacidad restrictiva (menor a 600 bultos)
db.bodegas.find({ "capacidad_maxima_bultos": { $lt: 600 } });

// 5. Bodegas inactivas que requieren auditoría o mantenimiento físico
db.bodegas.find({ "estado_activo": false });

// 6. Buscar una bodega exacta utilizando su identificador único (_id: 10)
db.bodegas.find({ "_id": 10 });

// 7. Bodegas activas que posean una capacidad intermedia (entre 800 y 1300 bultos)
db.bodegas.find({ "estado_activo": true, "capacidad_maxima_bultos": { $gte: 800, $lte: 1300 } });


print("--- EJECUTANDO CONSULTAS ESPECÍFICAS DE ENTRADAS ---");
// 1. Entradas registradas bajo la modalidad de 'compra'
db.entradas.find({ "tipo_ingreso": "compra" });

// 2. Entradas con un volumen masivo de bultos (superior a 300 unidades ingresadas)
db.entradas.find({ "cantidad_ingresada": { $gt: 300 } });

// 3. Filtrar buscando dentro del subdocumento: Producto con un 12% de fósforo
db.entradas.find({ "producto_embebido.porcentaje_fosforo": 12.0 });

// 4. Buscar lotes por coincidencia exacta de su nomenclatura de planta ("LOT-2026-V5")
db.entradas.find({ "numero_lote": "LOT-2026-V5" });

// 5. Entradas cuyo stock mínimo de seguridad registrado en auditoría sea superior a 30 bultos
db.entradas.find({ "stock_auditoria.stock_minimo_seguridad": { $gt: 30 } });

// 6. Entradas asignadas específicamente a la Bodega con ID de referencia 2
db.entradas.find({ "id_bodega": 2 });

// 7. Buscar registros de entradas cuyas observaciones contengan el término de control 'calidad'
db.entradas.find({ "observaciones": /calidad/i });


