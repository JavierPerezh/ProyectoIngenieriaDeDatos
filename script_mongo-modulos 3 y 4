// Modificación 2: Cambiar de estado a inactivo de forma masiva a bodegas de muy baja capacidad (< 500)
db.bodegas.updateMany(
  { "capacidad_maxima_bultos": { $lt: 500 } },
  { $set: { "estado_activo": false } }
);

// Modificación 3: Corregir y ampliar las observaciones del lote de producción LOT-2026-V1
