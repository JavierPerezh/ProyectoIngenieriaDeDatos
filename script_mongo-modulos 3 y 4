// =============================================================================
// 7. CONSULTAS CRUZADAS / AGREGACIONES (JOINS EQUIVALENTES EN NOSQL)
// =============================================================================
print("--- EJECUTANDO PIPELINES ANALÍTICOS DE CONSULTAS CRUZADAS ($LOOKUP) ---");

// Consulta Cruzada 1: Reporte Maestro Logístico (Cruza Lotes con sus Bodegas de Custodia)
db.entradas.aggregate([
  {
    $lookup: {
      from: "bodegas",
      localField: "id_bodega",
      foreignField: "_id",
      as: "bodega_relacionada"
    }
  },
  {
    $unwind: "$bodega_relacionada"
  },
  {
    $project: {
      "_id": 0,
      "Lote": "$numero_lote",
      "Cantidad_Ingresada": "$cantidad_ingresada",
      "Nombre_Producto": "$producto_embebido.nombre_sal_mineralizada",
      "Bodega_Almacenada": "$bodega_relacionada.nombre_bodega",
      "Ubicacion_Fisica": "$bodega_relacionada.direccion_fisica",
      "Estado_Bodega": "$bodega_relacionada.estado_activo"
    }
  }
]);

// Consulta Cruzada 2: Consolidado de Carga por Infraestructura Activa
db.entradas.aggregate([
  {
    $group: {
      "_id": "$id_bodega",
      "lotes_totales": { $sum: 1 },
      "bultos_acumulados": { $sum: "$cantidad_ingresada" }
    }
  },
  {
    $lookup: {
      from: "bodegas",
      localField: "_id",
      foreignField: "_id",
      as: "info_bodega"
    }
  },
  {
    $unwind: "$info_bodega"
  },
  {
    $project: {
      "_id": 0,
      "ID_Bodega": "$_id",
      "Bodega": "$info_bodega.nombre_bodega",
      "Capacidad_Maxima_Diseño": "$info_bodega.capacidad_maxima_bultos",
      "Lotes_Procesados": "$lotes_totales",
      "Total_Bultos_Recibidos": "$bultos_acumulados"
    }
  }
]);
