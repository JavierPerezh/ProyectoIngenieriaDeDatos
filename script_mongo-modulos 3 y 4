);

// Modificación 4: Actualizar de forma masiva el tipo de ingreso de "produccion" a "PRODUCCIÓN INTERNA"
db.entradas.updateMany(
  { "tipo_ingreso": "produccion" },
  { $set: { "tipo_ingreso": "PRODUCCIÓN INTERNA" } }
);

// Modificación 5: Modificar un campo anidado dentro del subdocumento de auditoría para la entrada con ID 3
