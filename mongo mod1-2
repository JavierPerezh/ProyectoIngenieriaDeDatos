function sp_crear_categoria(
  p_codigo,
  p_nombre,
  p_desc,
  p_fosforo
) {
  if (
    String(p_codigo || "").trim().length === 0 ||
    String(p_nombre || "").trim().length === 0
  ) {
    throw new Error("Campos obligatorios vacíos")
  }

  const id_categoria = nextSequence("categoria")

  db.categoria.insertOne({
    id_categoria,
    codigo_categoria: String(p_codigo).trim().toUpperCase(),
