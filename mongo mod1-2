}

function sp_actualizar_usuario(
  p_id,
  p_nombre,
  p_nuevo_password,
  p_rol
) {
  const usuario = db.usuario.findOne({ id_usuario: p_id })

  if (!usuario) {
    throw new Error("Usuario no existe")
  }

  const update = {}

  if (p_nombre !== null && p_nombre !== undefined) {
    update.nombre_completo = String(p_nombre).trim()
  }

  if (p_nuevo_password !== null && p_nuevo_password !== undefined) {
    const salt = randomHex(32)

    update.password_salt = salt
    update.password_hash = sha256(String(p_nuevo_password) + salt)
  }

  if (p_rol !== null && p_rol !== undefined) {
    const rol = String(p_rol).toUpperCase()

    if (!["ADMIN", "VENDEDOR"].includes(rol)) {
      throw new Error("Rol inválido")
    }

    update.rol = rol
  }

  if (Object.keys(update).length > 0) {
    db.usuario.updateOne(
      { id_usuario: p_id },
      { $set: update }
    )
  }

  return db.vw_usuarios_sistema.findOne({ id_usuario: p_id })
}

function sp_desactivar_usuario(p_id) {
  db.usuario.updateOne(
    { id_usuario: p_id },
    {
      $set: {
        estado_activo: 0,
        fecha_desactivacion: new Date()
      }
    }
  )

  db.sesion_usuario.updateMany(
    {
      id_usuario: p_id,
      estado_sesion: "ABIERTA"
    },
    {
      $set: {
        estado_sesion: "CERRADA",
        fecha_cierre: new Date()
      }
    }
  )

  return db.vw_usuarios_sistema.findOne({ id_usuario: p_id })
}

function sp_iniciar_sesion(p_documento, p_password) {
  const usuario = db.usuario.findOne({
    numero_documento: String(p_documento).trim()
  })

  if (!usuario) {
    throw new Error("Credenciales inválidas")
  }

  if (usuario.estado_activo === 0) {
    throw new Error("Usuario inactivo")
  }

  const hash = sha256(String(p_password) + usuario.password_salt)

  if (hash !== usuario.password_hash) {
    throw new Error("Credenciales inválidas")
  }

  const token = sha256(
    ObjectId().toString() +
    Math.random().toString() +
    new Date().getTime().toString() +
    usuario.id_usuario.toString()
  )

  db.sesion_usuario.insertOne({
    id_sesion: nextSequence("sesion_usuario"),
    id_usuario: usuario.id_usuario,
    token_sesion: token,
    estado_sesion: "ABIERTA",
    fecha_apertura: new Date(),
    fecha_cierre: null
  })

  db.usuario.updateOne(
    { id_usuario: usuario.id_usuario },
    {
      $set: {
        ultimo_acceso: new Date()
      }
    }
  )

  return {
    resultado: "LOGIN_OK",
    token_sesion: token,
    id_usuario: usuario.id_usuario,
    nombre: usuario.nombre_completo,
    rol: usuario.rol
  }
}

function sp_cerrar_sesion(p_token) {
  db.sesion_usuario.updateMany(
    {
      token_sesion: p_token,
      estado_sesion: "ABIERTA"
    },
    {
      $set: {
        estado_sesion: "CERRADA",
        fecha_cierre: new Date()
      }
    }
  )

  return {
    resultado: "LOGOUT_OK"
  }
}

