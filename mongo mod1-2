function seedUsuario(nombre, username, email, documento, password, rol) {
  const existe = db.usuario.findOne({
    $or: [
      { username: username },
      { numero_documento: documento }
    ]
  })

  if (!existe) {
    return sp_crear_usuario(nombre, username, email, documento, password, rol)
  }

  return db.vw_usuarios_sistema.findOne({ id_usuario: existe.id_usuario })
}

