function sp_crear_usuario(
  p_nombre,
  p_username,
  p_email,
  p_documento,
  p_password,
  p_rol
) {
  if (
    String(p_nombre || "").trim().length === 0 ||
    String(p_username || "").trim().length === 0 ||
    String(p_documento || "").trim().length === 0 ||
    String(p_password || "").trim().length === 0
  ) {
    throw new Error("Campos obligatorios vacíos")
  }

  const rol = String(p_rol || "").toUpperCase()

  if (!["ADMIN", "VENDEDOR"].includes(rol)) {
    throw new Error("Rol inválido: solo ADMIN o VENDEDOR")
  }

  const id_usuario = nextSequence("usuario")
  const salt = randomHex(32)

  db.usuario.insertOne({
    id_usuario,
    nombre_completo: String(p_nombre).trim(),
    username: String(p_username).trim(),
    email: p_email === null || p_email === undefined ? null : String(p_email).trim(),
    numero_documento: String(p_documento).trim(),
    password_hash: sha256(String(p_password) + salt),
    password_salt: salt,
    rol,
    estado_activo: 1,
    fecha_creacion: new Date(),
    fecha_desactivacion: null,
    ultimo_acceso: null
  })

  return db.vw_usuarios_sistema.findOne({ id_usuario })
}

function sp_listar_usuarios() {
