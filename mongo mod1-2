}

function sp_listar_tipos_sal(
  p_nombre = null,
  p_codigo = null,
  p_id_categoria = null,
  p_incluir_inactivos = 0
) {
  const query = {}

  if (p_nombre !== null && p_nombre !== undefined) {
    query.nombre_sal_mineralizada = {
      $regex: escapeRegex(p_nombre),
      $options: "i"
    }
  }

  if (p_codigo !== null && p_codigo !== undefined) {
    query.codigo_tipo_sal = {
      $regex: escapeRegex(String(p_codigo).toUpperCase())
    }
  }

  if (p_id_categoria !== null && p_id_categoria !== undefined) {
    query.id_categoria = p_id_categoria
  }

  if (p_incluir_inactivos !== 1) {
    query.estado_tipo_sal = "ACTIVO"
  }

  return db.vw_tipos_sal
    .find(query)
    .sort({
      nombre_categoria: 1,
      nombre_sal_mineralizada: 1
    })
    .toArray()
}

